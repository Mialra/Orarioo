[flake8]
# Maximum line length (PEP 8 recommendation is 79, but 120+ is common for modern projects)
max-line-length = 120

# Ignore specific error codes
# E501: Line too long (handled by max-line-length)
# W503: Line break before binary operator
# E203: Whitespace before ':'
# E266: Too many leading '#' for block comment
ignore =
    E501,
    W503,
    E203,
    E266

# Exclude directories from linting
exclude =
    .git,
    __pycache__,
    .githooks,
    venv,
    .venv,
    env,
    .env,
    migrations,
    .pytest_cache,
    .coverage,
    htmlcov,
    node_modules,
    build,
    dist

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    manage.py:F401
    settings.py:F401,E501
    wsgi.py:F401
    asgi.py:F401

# Complexity thresholds
max-complexity = 10

# Count errors and warnings
count = True

# Show source code for errors
show-source = True

# Show pep8 offsets for errors
show-pep8 = True
