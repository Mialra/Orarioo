#!/bin/sh
# commit-msg hook para validar Conventional Commits
# Se ejecuta automáticamente cuando haces `git commit`

# Read the commit message (temporal file passed by git)
commit_message=$(cat "$1")

# Ignore: merge commits, revert commits, pull request merges and fixup/squash commits
case "$commit_message" in
  Merge\ *|Revert\ *|Pull\ *|fixup\!*|squash\!*)
    exit 0
    ;;
esac

# Regular expression for the expected format
conventional_regex='^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|reverts)(\([a-z0-9_\-]+\))?: .{1,}$'

# Validate
if echo "$commit_message" | grep -Eq "$conventional_regex"; then
    echo "✅ Commit message follows Conventional Commits."
    exit 0
else
    echo "❌ Invalid commit message."
    echo "Correct format: type(scope): description — e.g.: feat(auth): add login" >&2
    exit 1
fi
